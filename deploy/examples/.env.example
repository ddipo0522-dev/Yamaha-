# Example environment variables for Fusion Factory deployment
# Copy this to .env and fill in real values
# NEVER commit .env to Git

# Fusion Dashboard
FUSION_PORT=4040
FUSION_HOST=127.0.0.1

# OpenRouter API Key (required for AI tasks)
# Get from https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# Cloudflare Tunnel Token (for named tunnel)
# Get from Cloudflare Zero Trust dashboard
# CLOUDFLARE_TUNNEL_TOKEN=...

# PostgreSQL (for production - use external DB instead of embedded)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=fusion
# POSTGRES_USER=fusion
# POSTGRES_PASSWORD=...
